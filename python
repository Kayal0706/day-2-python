# Day 2 - Python Basics

# 1. Variables and Data Types

name = "Jkayal"
age = 22
height = 6.8
is_student = True

print("Name:", name)
print("Age:", age)
print("Height:", height)
print("Student:", is_student)


# 2. Data Types

print("\nData Types:")

print(type(name))
print(type(age))
print(type(height))
print(type(is_student))


# 3. Operators

a = 20
b = 10

print("\nOperators:")

print("Addition:", a + b)
print("Subtraction:", a - b)
print("Multiplication:", a * b)
print("Division:", a / b)
print("Modulus:", a % b)


# 4. Conditional Statement

print("\nConditional Statement:")

if age >= 18:
    print("Eligible for voting")
else:
    print("Not eligible for voting")


# 5. For Loop

print("\nFor Loop:")

for i in range(1, 6):
    print(i)


# 6. While Loop

print("\nWhile Loop:")

count = 1

while count <= 5:
    print(count)
    count += 1


# 7. Function

def greet(name):
    return "Hello, " + name

print("\nFunction:")
print(greet(name))


# 8. Calculator Function

def calculator(a, b):
    print("Addition:", a + b)
    print("Subtraction:", a - b)
    print("Multiplication:", a * b)
    print("Division:", a / b)


print("\nCalculator:")
calculator(20, 10)
